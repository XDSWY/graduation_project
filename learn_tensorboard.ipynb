   "source": [
    "from torch.utils.tensorboard import SummaryWriter\n",
    "import os"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e39573b0-1c20-4b23-a808-c307d6174787",
   "metadata": {},
   "outputs": [],
   "source": [
    "writer = SummaryWriter(\"logs\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "798609c7-a09f-47a8-b362-552126cfd552",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i in range(100):\n",
    "    writer.add_scalar(\"y=x\", i, i)\n",
    "\n",
    "writer.close()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "74028739-e112-4d79-8b69-2daac875e22f",
   "metadata": {},
   "outputs": [],
   "source": [
    "os.system('tensorboard --logdir=logs')"
   ]
  },
